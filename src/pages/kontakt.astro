---
import Layout from '../layouts/Layout.astro';
import { Picture } from 'astro:assets';
import { breadcrumb, company } from '../data/site';
import production from '../assets/original/production.jpg';
import volume from '../assets/original/volume.jpg';

const og = production;
const org = {
  '@context': 'https://schema.org',
  '@type': 'LocalBusiness',
  name: 'Etch A/S',
  telephone: company.phone,
  email: company.email,
  address: {
    '@type': 'PostalAddress',
    streetAddress: company.street,
    postalCode: '3520',
    addressLocality: 'Farum',
    addressCountry: 'DK',
  },
  openingHours: 'Mo-Fr 08:00-16:00',
  url: 'https://etch.dk/kontakt/',
};
---
<Layout
  title="Kontakt Etch – Bygmarken 3, Farum"
  description="Kontakt Etch A/S i Farum. Ring på +45 27 11 65 59 eller skriv til info@etch.dk. Vi er åbne 08.00–16.00 på Bygmarken 3, 3520 Farum."
  path="/kontakt/"
  image={og}
  jsonld={[
    breadcrumb([
      { name: 'Forside', path: '/' },
      { name: 'Kontakt', path: '/kontakt/' },
    ]),
    org,
  ]}
>
  <section class="section wrap pagehead">
    <div class="split" style="align-items:center">
      <div>
        <h1 data-rise style="--i:0">Kontakt os</h1>
        <p class="lead" data-rise style="--i:1; margin-top:1rem">
          Vi sidder klar til at besvare dine spørgsmål om faconætsning, pris og leveringstid.
        </p>
        <p style="margin-top:1.1rem; max-width:64ch" data-rise style="--i:2">
          Har du en tegning eller en skitse, du gerne vil have prissat? Send den til os, så vender
          vi tilbage med et forslag til materiale, tykkelse, overfladebehandling og leveringstid.
          De fleste forespørgsler besvarer vi samme dag, og prototyper leverer vi ofte fra dag til dag.
        </p>
        <p style="margin-top:1.1rem; max-width:64ch" data-rise style="--i:3">
          Har du ikke en færdig CAD-tegning, er det også helt i orden. En skitse, et foto eller en
          beskrivelse af målene er som udgangspunkt nok til, at vi kan vurdere emnet, vælge faconætsning
          eller en anden metode og give dig en realistisk pris. Vi hjælper gerne med at vælge den rette
          plade, overflade og tolerance, så emnet overholder dine krav ved første leverance.
        </p>
      </div>
      <figure class="figure">
        <Picture src={production} alt="Hånd i enganghandske fører et ætset metalark gennem en maskine" widths={[480, 960]} formats={['avif','webp']} sizes="(min-width:48rem) 46vw, 92vw" />
        <figcaption class="cap small">Fra tegning til leveret emne</figcaption>
      </figure>
    </div>
  </section>

  <section class="section wrap" style="padding-top:0">
    <h2 style="font-size:var(--step-head); margin-bottom:1.6rem">Sådan når du os</h2>
    <div class="contact-grid">
      <div class="contact-block">
        <div class="k">Ring til os</div>
        <a class="v" href={company.phoneHref}>+45 27 11 65 59</a>
        <p class="muted" style="margin-top:.4rem">Ring for yderligere information om vores produkter.</p>
      </div>
      <div class="contact-block">
        <div class="k">Skriv til os</div>
        <a class="v" href={company.emailHref}>info@etch.dk</a>
        <p class="muted" style="margin-top:.4rem">Send en CAD-fil eller en skitse – vi vender tilbage med et forslag.</p>
      </div>
      <div class="contact-block">
        <div class="k">Adresse</div>
        <div class="v">{company.street}, {company.zip}</div>
        <p class="muted" style="margin-top:.4rem">Åben {company.hours} (man–fre).</p>
      </div>
      <div class="contact-block">
        <div class="k">Fastnet</div>
        <a class="v" href="tel:+4544956566">{company.phone2}</a>
        <p class="muted" style="margin-top:.4rem; white-space:nowrap">Hverdage {company.hours}</p>
      </div>
    </div>
  </section>

  <section class="section" style="background:var(--surface)">
    <div class="wrap split" style="align-items:center">
      <div>
        <h2 style="font-size:var(--step-head)">Ring i god tid</h2>
        <p class="muted" style="margin-top:.6rem; margin-bottom:1.4rem">Så kan vi sikre lager og hurtig levering af netop dit materiale.</p>
        <div style="display:flex; flex-wrap:wrap; gap:.8rem">
          <a class="button big" href={company.phoneHref}>Ring til os</a>
          <a class="button big ghost" href={company.emailHref}>Send en e-mail</a>
        </div>
      </div>
      <figure class="figure" data-reveal>
        <Picture src={volume} class="wide" alt="Flere ark med ætsede metaldele i produktionen" widths={[480, 960]} formats={['avif','webp']} sizes="(min-width:48rem) 46vw, 92vw" />
        <figcaption class="cap small">Ætset serie på ark</figcaption>
      </figure>
    </div>
  </section>
</Layout>
