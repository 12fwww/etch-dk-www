---
import { Picture } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import { breadcrumb, base } from '../data/site';
import costGraph from '../assets/original/cost-graph.png';
import costLines from '../assets/original/cost-lines.png';

const og = costGraph;
---
<Layout
  title="Økonomiske fordele ved faconætsning | Etch"
  description="Faconætsning er ofte et økonomisk attraktivt alternativ til laserskæring og stansning. Sammenlign startomkostninger og hvor grænserne X1 og X2 ligger hos Etch A/S."
  path="/oekonomiske-fordele/"
  image={og}
  jsonld={[breadcrumb([
    { name: 'Forside', path: '/' },
    { name: 'Økonomiske fordele', path: '/oekonomiske-fordele/' },
  ])]}
>
  <section class="section wrap pagehead">
    <h1 data-rise style="--i:0">Økonomiske fordele ved faconætsning</h1>
    <p class="lead" data-rise style="--i:1; margin-top:1rem">
      En overordnet økonomisk sammenligning med de almindeligste former for formgivning i
      metalliske tyndpladematerialer viser, at faconætsning ofte er et økonomisk attraktivt
      alternativ.
    </p>
  </section>

  <!-- three cost blocks -->
  <section class="section wrap" style="padding-top:0">
    <div class="costs" data-reveal>
      <div class="cost field-ink">
        <div class="tech" style="color:#fff">Laserskæring</div>
        <div class="price">1.500–4.000 kr.</div>
        <div style="font-size:var(--step-small); color:#c9c6bf">Startomkostning (programmering + opstilling), typisk.</div>
        <p style="color:#c9c6bf">Skæretiden bestemmer hovedsageligt stykprisen.</p>
      </div>
      <div class="cost field-grey">
        <div class="tech" style="color:#fff">Stans</div>
        <div class="price">75.000–400.000 kr.</div>
        <div style="font-size:var(--step-small); color:#d9d6cf">Startomkostning (konstruktion og værktøj), typisk.</div>
        <p style="color:#d9d6cf">Råmaterialet, bemanding, maskinens timepris og vedligehold giver stykprisen.</p>
      </div>
      <div class="cost field-red">
        <div class="tech" style="color:#fff">Faconætsning</div>
        <div class="price" style="color:#fff">2.000–5.000 kr.</div>
        <div style="font-size:var(--step-small); color:#f3dede">Startomkostning (CAD-tegning og master), typisk.</div>
        <p style="color:#f3dede">Antallet af emner pr. ark, materialet og tykkelsen bestemmer stykprisen.</p>
      </div>
    </div>
  </section>

  <!-- the real graph -->
  <section class="section" style="background:var(--surface)">
    <div class="wrap">
      <h2 data-rise style="--i:0">Totalprisen som funktion af antal emner</h2>
      <p class="muted" style="margin-top:.6rem; margin-bottom:1.6rem; max-width:52ch">
        Grafen sammenligner totalprisen for tre produktionsteknologier som en funktion af det
        producerede antal emner. Det interessante er, hvor grænserne for den økonomiske fordel
        ved faconætsning ligger.
      </p>
      <figure class="figure" style="max-width:620px; margin:0 auto" data-reveal>
        <Picture src={costGraph} alt="Graf over totalpris som funktion af produceret antal emner for stansning, laserskæring og faconætsning" widths={[480, 800, 1024]} format={['avif','webp']} sizes="(min-width:48rem) 60vw, 92vw" />
        <figcaption class="cap" style="text-align:center">Totalprisen som funktion af produceret antal emner for tre produktionsteknologier</figcaption>
      </figure>
    </div>
  </section>

  <!-- crossover table -->
  <section class="section wrap">
    <h2 data-rise style="--i:0">Hvor grænserne ligger</h2>
    <p class="muted" style="margin-top:.6rem; margin-bottom:1.6rem; max-width:56ch">
      Det er stærkt afhængigt af den konkrete opgave, men typisk ligger de økonomiske grænser
      (X1 og X2) således:
    </p>
    <div class="split" data-reveal>
      <div style="background:var(--surface); padding:1.4rem">
        <table class="xtable">
          <caption>Typiske grænser for den økonomiske fordel ved faconætsning</caption>
          <thead>
            <tr><th>Type emne</th><th>X1 (fra)</th><th>X2 (til)</th></tr>
          </thead>
          <tbody>
            <tr><td>Større emner</td><td class="nums">100 stk.</td><td class="nums">10.000 stk.</td></tr>
            <tr><td>Små emner</td><td class="nums">1.000 stk.</td><td class="nums">100.000 stk.</td></tr>
            <tr><td>Meget komplekse emner*</td><td class="nums">10 stk.</td><td class="nums">1.000.000 stk.</td></tr>
          </tbody>
        </table>
        <p class="small muted" style="margin-top:.8rem">*) EMC-gaskets uden nedætsede fjedre.</p>
      </div>
      <figure class="figure" style="max-width:30rem">
        <Picture src={costLines} alt="Lille linjediagram: faconætsning stiger langsommere end stansning over antal emner" widths={[360]} format={['avif','webp']} sizes="30rem" />
        <figcaption class="cap">Hvor grænserne for den økonomiske fordel ligger</figcaption>
      </figure>
    </div>
  </section>

  <section class="section" style="background:var(--surface)">
    <div class="wrap" style="display:flex; flex-wrap:wrap; align-items:center; justify-content:space-between; gap:1.4rem">
      <div style="max-width:44ch">
        <h2 style="font-size:var(--step-head)">Vil du vide, hvor dit emne ligger?</h2>
        <p class="muted" style="margin-top:.6rem">Send os en tegning eller en skitse – vi rådgiver dig om den bedste løsning.</p>
      </div>
      <a class="button big" href={base + '/kontakt/'}>Kontakt os</a>
    </div>
  </section>
</Layout>
