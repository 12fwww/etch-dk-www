---
import { Picture } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import { breadcrumb, base } from '../data/site';
import precision from '../assets/original/precision.jpg';
import production from '../assets/original/production.jpg';
import volume from '../assets/original/volume.jpg';
import gaskets from '../assets/original/gaskets-cans.jpg';

const og = precision;
---
<Layout
  title="Om Etch – over 20 års erfaring i tyndplade | Etch"
  description="Etch A/S blev etableret i 2007 i Farum og indgår i et produktionsfællesskab med Sur-Tech. Over 20 års erfaring med emner i metallisk tyndplade."
  path="/om-etch/"
  image={og}
  jsonld={[breadcrumb([
    { name: 'Forside', path: '/' },
    { name: 'Om Etch', path: '/om-etch/' },
  ])]}
>
  <section class="section wrap pagehead">
    <div class="split" style="align-items:center">
      <div>
        <h1>Om Etch</h1>
        <p class="lead" style="margin-top:1rem">
          Etch A/S blev etableret den 2. april 2007 i nye produktionslokaler hos vores medejer
          Sur-Tech A/S i Farum.
        </p>
        <p style="margin-top:1rem">
          Vi indgår i et produktionsfællesskab med Sur-Tech, og kan herigennem udnytte vores
          fælles faciliteter og fleksible medarbejderstab.
        </p>
        <div style="margin-top:1.6rem; display:flex; flex-wrap:wrap; gap:.8rem">
          <a class="button big" href={base + '/kontakt/'}>Kontakt os</a>
          <a class="button big ghost" href={base + '/faconaetsning/'}>Se processen</a>
        </div>
      </div>
      <figure class="figure" data-reveal>
        <Picture
          src={volume}
          class="wide" alt="Flere ark med ætsede metaldele i produktionen"
          widths={[480, 960]}
          formats={['avif','webp']}
          sizes="(min-width:48rem) 46vw, 92vw"
         
        />
        <figcaption class="cap small">I produktion hos Sur-Tech i Farum</figcaption>
      </figure>
    </div>
  </section>

  <section class="section wrap" style="padding-top:0">
    <div class="split">
      <div style="display:grid; gap:1rem">
        <p data-rise style="--i:0">
          Vi leverer industrielle løsninger i metallisk tyndplade i seriestørrelser fra
          prototyper og 0-serier til produktionskvantiteter.
        </p>
        <p data-rise style="--i:1">
          Vores basisproces er faconætsning, men vi tilbyder ligeledes efterbearbejdning i form
          af bukning, galvanisk og kemisk overfladebehandling, laserskæring,
          &#8209;gravering og &#8209;svejsning m.m.
        </p>
        <p data-rise style="--i:2">
          Vi har over 20 års erfaring i udvikling og produktion af emner i metallisk
          tyndplade – fortrinsvis til elektronikindustrien. Etch har fokus på produktion i høj
          kvalitet og lægger stor vægt på kundeservice.
        </p>
        <p>
          Det at indgå i et produktionsfællesskab med Sur-Tech A/S betyder, at vi kan
          kombinere vores specialisering i faconætsning med en bred palette af efterbehandling
          – alt sammen under samme tag.
        </p>
      </div>
      <figure class="figure">
        <Picture
          src={precision}
          alt="Hånd holder et tyndt metalstykke i en digital mikrometer og måler tykkelsen"
          widths={[480, 960, 1440, 2048]}
          formats={['avif','webp']}
          sizes="(min-width:48rem) 50vw, 100vw"
         
        />
        <figcaption class="cap">Præcision målt til mikrometer</figcaption>
      </figure>
    </div>
  </section>

  <section class="section wrap">
    <h2 style="font-size:var(--step-head); margin-bottom:1.6rem">Et kig på tallene</h2>
    <div class="split" style="align-items:stretch">
      <div class="stats" style="grid-template-columns:1fr; align-self:stretch">
        <div class="stat field-ink">
          <div class="num" style="color:#fff">2007</div>
          <div class="lbl">Etableret i Farum, sammen med Sur-Tech A/S</div>
        </div>
        <div class="stat field-red">
          <div class="num">50&nbsp;µm–1&nbsp;mm</div>
          <div class="lbl" style="color:var(--accent-ink)">Tykkelse af tyndplade, vi forarbejder</div>
        </div>
        <div class="stat field-grey">
          <div class="num">20+&nbsp;år</div>
          <div class="lbl" style="color:#fff">Erfaring, fortrinsvis til elektronikindustrien</div>
        </div>
      </div>
      <figure class="figure">
        <Picture
          src={production}
          alt="Hånd i enganghandske fører et ætset metalark gennem en maskine"
          widths={[480, 960]}
          formats={['avif','webp']}
          sizes="(min-width:48rem) 46vw, 92vw"
         
        />
        <figcaption class="cap small">Flere tusinde emner – 20+ års erfaring, især til elektronikindustrien</figcaption>
      </figure>
    </div>
  </section>

  <section class="section" style="background:var(--surface)">
    <div class="wrap split" style="align-items:center">
      <div>
        <h2 style="font-size:var(--step-head)">Hvem er vi</h2>
        <p class="muted" style="margin-top:.6rem; margin-bottom:1.4rem">Etch A/S i Farum – din partner i faconætsning af tyndplade. Over 20 års erfaring i udvikling og produktion af emner i metallisk tyndplade.</p>
        <a class="button big" href={base + '/kontakt/'}>Kontakt os</a>
      </div>
      <figure class="figure" data-reveal>
        <Picture
          src={gaskets}
          alt="Gullige cylindriske metaldele med tandet kant, fotograferet på hvid baggrund"
          widths={[480, 960]}
          formats={['avif','webp']}
          sizes="(min-width:48rem) 46vw, 92vw"
         
        />
        <figcaption class="cap small">Ætset serie fra produktionen</figcaption>
      </figure>
    </div>
  </section>
</Layout>
